# Path to the Excel archive from the hackathon materials.
DATA_ZIP_PATH=C:\Users\ulana\Downloads\Excel_IEK_Systeme_Electric_оформленные.zip
AS_OF_DATE=2026-09-22

# Recommendation settings.
# 0 returns every product that needs an order; positive values explicitly cap the list.
MAX_RECOMMENDATIONS=0
SAFETY_STOCK_DAYS=14
IEK_LEAD_TIME_DAYS=18
SYSTEME_LEAD_TIME_DAYS=14

# AI is optional and runs only on the backend.
# Keep keys out of frontend .env files and out of VITE_* variables.
# template = no external API, openai/nvidia = one provider, auto = OpenAI then NVIDIA fallback.
AI_PROVIDER=template
AI_MAX_ROWS=8

# Optional paid chat on the public presentation server (app.share).
# Disabled by default; anyone with the link can send questions when enabled.
# Questions/history and a bounded calculation sample go to the selected AI provider.
SHARE_CHAT_ENABLED=false

# OpenAI: uses Responses API.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# NVIDIA: uses OpenAI-compatible NIM chat completions.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
