# Local development: Vite proxies /api/* to this backend and removes /api.
BACKEND_URL=http://127.0.0.1:8000
# Browser-visible base URL. Never put tokens or secrets in VITE_* variables.
VITE_API_BASE_URL=/api
# Set to /api/recommendations if your backend includes the /api prefix.
VITE_RECOMMENDATIONS_PATH=/recommendations
# Explicit opt-in only. Production builds use API mode unless changed here.
VITE_DATA_MODE=api

